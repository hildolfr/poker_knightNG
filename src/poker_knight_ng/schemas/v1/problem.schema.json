{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poker-knight-ng.dev/contracts/v1/problem.schema.json",
  "title": "Poker Knight NG v1 problem",
  "description": "Closed RFC 9457-style failure response for a rejected or failed v1 solve. Never a partial result.",
  "$comment": "Only this object represents failure; successful counters, probabilities, timing, seed, case hash, request fields, and provenance are deliberately absent. Root oneOf branches fix type, title, status, code, detail, and retryable together per stable code, so client-visible text cannot echo raw seed, cards, hashes, paths, payloads, or backend exception text. correlation_id is server-generated only and exactly pk_ plus 32 lowercase hex digits. field_errors contain structural paths and input/unsupported validation codes only; runtime/internal failures reject field_errors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "correlation_id",
    "retryable"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "code": {
      "enum": [
        "INVALID_CONTRACT_VERSION",
        "INVALID_CARD",
        "DUPLICATE_CARD",
        "INVALID_BOARD_LENGTH",
        "INVALID_OPPONENT_COUNT",
        "INVALID_TRIAL_COUNT",
        "INVALID_SEED",
        "UNSUPPORTED_FIELD",
        "UNSUPPORTED_REQUEST",
        "UNSUPPORTED_RNG",
        "BACKEND_UNAVAILABLE",
        "RNG_REJECTION_EXHAUSTED",
        "RESOURCE_EXHAUSTED",
        "INTERNAL_ERROR"
      ]
    },
    "detail": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^pk_[0-9a-f]{32}$",
      "description": "Server-generated portable correlation identifier: exactly pk_ plus 32 lowercase hexadecimal digits. It MUST NOT derive from request content. Planned test: canonical format and generated-only handling."
    },
    "retryable": {
      "type": "boolean"
    },
    "field_errors": {
      "type": "array",
      "maxItems": 32,
      "description": "Optional structural input/unsupported validation errors. Never echo submitted values or messages. Runtime/internal problem branches reject this property.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*|\\[[0-9]+\\])*$",
            "maxLength": 128
          },
          "code": {
            "enum": [
              "DUPLICATE_CARD",
              "INVALID_BOARD_LENGTH",
              "INVALID_CARD",
              "INVALID_CONTRACT_VERSION",
              "INVALID_OPPONENT_COUNT",
              "INVALID_SEED",
              "INVALID_TRIAL_COUNT",
              "UNSUPPORTED_FIELD",
              "UNSUPPORTED_REQUEST",
              "UNSUPPORTED_RNG"
            ]
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "urn:poker-knight-ng:problem:v1:invalid-contract-version"
        },
        "title": {
          "const": "Invalid contract version"
        },
        "status": {
          "const": 400
        },
        "code": {
          "const": "INVALID_CONTRACT_VERSION"
        },
        "detail": {
          "const": "The request contract version is not supported."
        },
        "retryable": {
          "const": false
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "retryable"
      ]
    },
    {
