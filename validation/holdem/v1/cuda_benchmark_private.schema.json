{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poker-knight-ng.invalid/validation/holdem/v1/cuda-benchmark-private.schema.json",
  "title": "Poker Knight NG Phase 6C private CUDA benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "benchmark_id", "source", "artifacts", "environment", "admission", "workers", "startup_cache", "startup", "matrix", "gates"],
  "properties": {
    "format_version": {"const": "phase6c-private-evidence-v1"},
    "benchmark_id": {"const": "holdem-v1-cuda-baseline-1"},
    "source": {"$ref": "#/$defs/source"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "environment": {"$ref": "#/$defs/environment"},
    "admission": {"$ref": "#/$defs/admission"},
    "workers": {"type": "array", "items": {"$ref": "#/$defs/worker"}, "minItems": 6, "maxItems": 6},
    "startup_cache": {"$ref": "#/$defs/startup_cache"},
    "startup": {"$ref": "#/$defs/startup"},
    "matrix": {"type": "array", "items": {"$ref": "#/$defs/cell"}, "minItems": 48, "maxItems": 48},
    "gates": {"$ref": "#/$defs/gates"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "counter": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
    "positive": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 20},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$", "maxLength": 31},
    "hex64": {"type": "string", "pattern": "^0x[0-9a-f]{16}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "sha256", "size_bytes"],
      "properties": {
        "basename": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9][A-Za-z0-9_./-]*$", "maxLength": 160},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"$ref": "#/$defs/positive"}
      }
    },
    "closure_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "sha256", "size_bytes"],
      "properties": {
        "basename": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9][A-Za-z0-9_./-]*$", "maxLength": 160},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"$ref": "#/$defs/counter"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "branch", "clean", "benchmark_tool_sha256", "cuda_runtime_source_sha256"],
      "properties": {
        "git_sha": {"$ref": "#/$defs/git_sha"},
        "branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$", "maxLength": 128},
        "clean": {"const": "true"},
        "benchmark_tool_sha256": {"$ref": "#/$defs/digest"},
        "cuda_runtime_source_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "sdist", "lock", "scenario_manifest", "phase5b_qualification", "phase5b_manifest", "phase5c_qualification", "phase5c_manifest", "installed_wheel_byte_closure"],
      "properties": {
        "wheel": {"$ref": "#/$defs/file"},
        "sdist": {"$ref": "#/$defs/file"},
        "lock": {"$ref": "#/$defs/file"},
        "scenario_manifest": {"$ref": "#/$defs/file"},
        "phase5b_qualification": {"$ref": "#/$defs/file"},
        "phase5b_manifest": {"$ref": "#/$defs/file"},
        "phase5c_qualification": {"$ref": "#/$defs/file"},
        "phase5c_manifest": {"$ref": "#/$defs/file"},
        "installed_wheel_byte_closure": {"type": "array", "items": {"$ref": "#/$defs/closure_file"}, "minItems": 1, "maxItems": 1024}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "python_version", "cuda_driver_version", "cuda_runtime_version", "cupy_version", "gpu_name", "gpu_uuid", "compute_capability", "device_memory_bytes"],
      "properties": {
        "os": {"type": "string", "pattern": "^[ -~]{1,80}$", "maxLength": 80},
        "kernel": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$", "maxLength": 80},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 31},
        "cuda_driver_version": {"$ref": "#/$defs/positive"},
        "cuda_runtime_version": {"$ref": "#/$defs/positive"},
        "cupy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 31},
        "gpu_name": {"type": "string", "pattern": "^[ -~]{1,160}$", "maxLength": 160},
        "gpu_uuid": {"type": "string", "pattern": "^GPU-[0-9a-f]{32}$"},
        "compute_capability": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "maxLength": 15},
        "device_memory_bytes": {"$ref": "#/$defs/positive"}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_uuid", "free_bytes", "total_bytes", "compute_applications", "gpu_snapshot_hex", "compute_snapshot_hex", "gpu_snapshot_sha256", "compute_snapshot_sha256"],
      "properties": {
        "gpu_uuid": {"type": "string", "pattern": "^GPU-[0-9a-f]{32}$"},
        "free_bytes": {"$ref": "#/$defs/counter"},
        "total_bytes": {"$ref": "#/$defs/positive"},
        "compute_applications": {"const": []},
        "gpu_snapshot_hex": {"type": "string", "pattern": "^[0-9a-f]{2,8192}$", "maxLength": 8192},
        "compute_snapshot_hex": {"type": "string", "pattern": "^[0-9a-f]{0,8192}$", "maxLength": 8192},
        "gpu_snapshot_sha256": {"$ref": "#/$defs/digest"},
        "compute_snapshot_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {"before": {"$ref": "#/$defs/memory"}, "after": {"$ref": "#/$defs/memory"}}
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_class", "mode", "ordinal", "fresh_process", "exit_code", "stdout_bytes", "stderr_bytes", "stdout_sha256", "stderr_sha256", "output_limit_bytes", "payload", "payload_sha256"],
      "properties": {
        "cache_class": {"enum": ["inventory", "expected-isolated", "startup-cold", "startup-warm", "steady-isolated", "stage-isolated"]},
        "mode": {"enum": ["inventory", "expected", "cold", "warm", "steady", "stage"]},
        "ordinal": {"enum": ["0", "1", "2", "3", "4", "5"]},
        "fresh_process": {"const": "true"},
        "exit_code": {"const": "0"},
        "stdout_bytes": {"$ref": "#/$defs/counter"},
        "stderr_bytes": {"$ref": "#/$defs/counter"},
        "stdout_sha256": {"$ref": "#/$defs/digest"},
        "stderr_sha256": {"$ref": "#/$defs/digest"},
        "output_limit_bytes": {"$ref": "#/$defs/positive"},
        "payload": {"type": "object"},
        "payload_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h2d_ns", "simulate_ns", "reduction_ns", "d2h_ns"],
      "properties": {
        "h2d_ns": {"$ref": "#/$defs/counter"},
        "simulate_ns": {"$ref": "#/$defs/counter"},
        "reduction_ns": {"$ref": "#/$defs/counter"},
        "d2h_ns": {"$ref": "#/$defs/counter"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analytical_sha256", "duration_ns", "throughput_per_second"],
      "properties": {
        "analytical_sha256": {"$ref": "#/$defs/digest"},
        "duration_ns": {"$ref": "#/$defs/positive"},
        "throughput_per_second": {"$ref": "#/$defs/decimal"}
      }
    },
    "cache_seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold_result_sha256", "files", "format_version"],
      "properties": {
        "cold_result_sha256": {"$ref": "#/$defs/digest"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$", "maxLength": 512},
              "sha256": {"$ref": "#/$defs/digest"},
              "size_bytes": {"$ref": "#/$defs/counter"}
            }
          }
        },
        "format_version": {"const": "phase6c-cache-seal-v1"}
      }
    },
    "startup_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold_worker_ordinal", "warm_worker_ordinal", "relationship", "cold_seal", "warm_verified_seal"],
      "properties": {
        "cold_worker_ordinal": {"const": "2"},
        "warm_worker_ordinal": {"const": "3"},
        "relationship": {"const": "shared_run_owned_0700_prepared_empty_sealed_after_cold_verified_immediately_before_warm"},
        "cold_seal": {"$ref": "#/$defs/cache_seal"},
        "warm_verified_seal": {"$ref": "#/$defs/cache_seal"}
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary_cell_id", "cold", "warm"],
      "properties": {
        "canary_cell_id": {"const": "v1-preflop-o1-n10000"},
        "cold": {"$ref": "#/$defs/sample"},
        "warm": {"$ref": "#/$defs/sample"}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum_ns", "p5_ns", "p50_ns", "p95_ns", "maximum_ns", "throughput_per_second"],
      "properties": {
        "count": {"const": "30"},
        "minimum_ns": {"$ref": "#/$defs/positive"},
        "p5_ns": {"$ref": "#/$defs/positive"},
        "p50_ns": {"$ref": "#/$defs/positive"},
        "p95_ns": {"$ref": "#/$defs/positive"},
        "maximum_ns": {"$ref": "#/$defs/positive"},
        "throughput_per_second": {"$ref": "#/$defs/decimal"}
      }
    },
    "steady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_duration_ns", "warmup_analytical_sha256", "durations_ns", "analytical_sha256s", "aggregate"],
      "properties": {
        "warmup_duration_ns": {"$ref": "#/$defs/positive"},
        "warmup_analytical_sha256": {"$ref": "#/$defs/digest"},
        "durations_ns": {"type": "array", "items": {"$ref": "#/$defs/positive"}, "minItems": 30, "maxItems": 30},
        "analytical_sha256s": {"type": "array", "items": {"$ref": "#/$defs/digest"}, "minItems": 30, "maxItems": 30},
        "aggregate": {"$ref": "#/$defs/aggregate"}
      }
    },
    "stage_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durations", "analytical_sha256"],
      "properties": {
        "durations": {"$ref": "#/$defs/stages"},
        "analytical_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "street", "opponent_count", "requested_trials", "backend", "seed", "expected_analytical_sha256", "steady", "stage"],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^v1-(preflop|flop|turn|river)-o(1|3|6)-n(10000|100000|500000|1000000)$", "maxLength": 32},
        "street": {"enum": ["preflop", "flop", "turn", "river"]},
        "opponent_count": {"enum": ["1", "3", "6"]},
        "requested_trials": {"enum": ["10000", "100000", "500000", "1000000"]},
        "backend": {"const": "cuda"},
        "seed": {"$ref": "#/$defs/hex64"},
        "expected_analytical_sha256": {"$ref": "#/$defs/digest"},
        "steady": {"$ref": "#/$defs/steady"},
        "stage": {"$ref": "#/$defs/stage_run"}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout", "artifacts", "environment", "admission", "worker", "matrix", "statistics"],
      "properties": {
        "checkout": {"const": "passed"}, "artifacts": {"const": "passed"},
        "environment": {"const": "passed"}, "admission": {"const": "passed"},
        "worker": {"const": "passed"}, "matrix": {"const": "passed"},
        "statistics": {"const": "passed"}
      }
    }
  }
}
