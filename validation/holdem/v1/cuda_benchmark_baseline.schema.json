{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://poker-knight-ng.invalid/validation/holdem/v1/cuda-benchmark-baseline.schema.json",
  "title":"Poker Knight NG Phase 6C public CUDA baseline projection",
  "type":"object","additionalProperties":false,
  "required":["format_version","benchmark_id","source","hashes","cuda","outcome","cells"],
  "properties":{
    "format_version":{"const":"phase6c-public-baseline-v1"},"benchmark_id":{"const":"holdem-v1-cuda-baseline-1"},
    "source":{"type":"object","additionalProperties":false,"required":["clean_commit_sha"],"properties":{"clean_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "hashes":{"type":"object","additionalProperties":false,"required":["lockfile_sha256","scenario_manifest_sha256","controller_sha256","method_sha256","wheel_sha256","sdist_sha256","installed_closure_sha256","phase5b_authority_sha256","phase5b_manifest_sha256","phase5c_authority_sha256","phase5c_manifest_sha256","private_evidence_sha256"],"properties":{"lockfile_sha256":{"$ref":"#/$defs/hash"},"scenario_manifest_sha256":{"$ref":"#/$defs/hash"},"controller_sha256":{"$ref":"#/$defs/hash"},"method_sha256":{"$ref":"#/$defs/hash"},"wheel_sha256":{"$ref":"#/$defs/hash"},"sdist_sha256":{"$ref":"#/$defs/hash"},"installed_closure_sha256":{"$ref":"#/$defs/hash"},"phase5b_authority_sha256":{"$ref":"#/$defs/hash"},"phase5b_manifest_sha256":{"$ref":"#/$defs/hash"},"phase5c_authority_sha256":{"$ref":"#/$defs/hash"},"phase5c_manifest_sha256":{"$ref":"#/$defs/hash"},"private_evidence_sha256":{"$ref":"#/$defs/hash"}}},
    "cuda":{"type":"object","additionalProperties":false,"required":["identity"],"properties":{"identity":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","pattern":"^(cuda-uuid|cuda-source-sha256):[0-9a-f]{32,64}$"}}}},
    "outcome":{"type":"object","additionalProperties":false,"required":["protocol","category"],"properties":{"protocol":{"const":"complete"},"category":{"const":"complete"}}},
    "cells":{"type":"array","minItems":48,"maxItems":48,"items":{"type":"object","additionalProperties":false,"required":["scenario_id","street","opponent_count","requested_trials","run_class","steady","stages"],"properties":{"scenario_id":{"type":"string","pattern":"^v1-(preflop|flop|turn|river)-o(1|3|6)-n(10000|100000|500000|1000000)$"},"street":{"enum":["preflop","flop","turn","river"]},"opponent_count":{"enum":["1","3","6"]},"requested_trials":{"enum":["10000","100000","500000","1000000"]},"run_class":{"const":"steady"},"steady":{"type":"object","additionalProperties":false,"required":["p5_ns","p50_ns","p95_ns","p50_throughput_per_second"],"properties":{"p5_ns":{"$ref":"#/$defs/positive"},"p50_ns":{"$ref":"#/$defs/positive"},"p95_ns":{"$ref":"#/$defs/positive"},"p50_throughput_per_second":{"$ref":"#/$defs/decimal"}}},"stages":{"type":"object","additionalProperties":false,"required":["h2d_ns","simulate_ns","reduction_ns","d2h_ns"],"properties":{"h2d_ns":{"$ref":"#/$defs/counter"},"simulate_ns":{"$ref":"#/$defs/counter"},"reduction_ns":{"$ref":"#/$defs/counter"},"d2h_ns":{"$ref":"#/$defs/counter"}}}}}}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"counter":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"positive":{"type":"string","pattern":"^[1-9][0-9]*$"},"decimal":{"type":"string","pattern":"^[1-9][0-9]*(\\.[0-9]{3})$"}}
}
