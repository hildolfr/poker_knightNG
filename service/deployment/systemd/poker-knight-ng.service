[Unit]
Description=Poker Knight NG bounded local service (deployment scaffold; inactive pending conformance)
After=network-online.target
Wants=network-online.target
RefuseManualStart=yes

[Service]
Type=simple
User=poker-knight-ng
Group=poker-knight-ng
RuntimeDirectory=poker-knight-ng
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/poker-knight-ng
ExecStart=/usr/bin/env poker-knight-ng-service
Restart=always
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
